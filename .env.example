# ────────────────────────────────────────────────────────────────────────────
# DriveAI — Variables de entorno (plantilla)
#
# 1) Copia este archivo a `.env`:
#       cp .env.example .env          (macOS / Linux)
#       copy .env.example .env        (Windows PowerShell)
#
# 2) Completá OBLIGATORIAMENTE estas 3 variables antes de `docker compose up`:
#       JWT_SECRET          → openssl rand -base64 48
#       ADMIN_EMAIL         → email del administrador de la demo
#       ADMIN_PASSWORD      → contraseña del administrador de la demo
#    GROQ_API_KEY es OPCIONAL: sin clave el asesor IA responde 503.
#
# 3) CERO secretos versionados: `.env` está excluido del repositorio.
# ────────────────────────────────────────────────────────────────────────────

# ===== PostgreSQL =====
POSTGRES_DB=cardb
POSTGRES_USER=cardb_user
# Contraseña de desarrollo. Cámbiala antes de desplegar en producción.
POSTGRES_PASSWORD=cardb_pass
# Puerto expuesto de PostgreSQL en el anfitrión.
POSTGRES_PORT=5432

# ===== RabbitMQ (broker de mensajería) =====
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Puerto AMQP y panel de administración (http://localhost:15672).
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ===== Groq Cloud (LLM / IA) =====
# Obtén tu API Key gratis en https://console.groq.com/keys
# Formato esperado: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Si queda vacía, el e-commerce funciona y el asesor IA devuelve 503.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ===== Backend (Spring Boot) =====
# Perfiles: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Máximo de recomendaciones IA permitidas por minuto y por usuario/IP.
RATE_LIMIT_PER_MINUTE=5
# Máximo de intentos de login por minuto y por IP+email (anti fuerza bruta).
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ===== Seguridad JWT / Admin inicial =====
# Secreto de firma de tokens (>= 32 bytes en Base64). Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=
# Minutos de vigencia del token (1440 = 24 h).
JWT_EXPIRATION_MINUTES=1440
# Emisor esperado del JWT. Un token de otro emisor se rechaza con 401.
JWT_ISSUER=driveai
# Cuenta admin que se crea automáticamente en el primer arranque (si no existe).
ADMIN_EMAIL=
# Contraseña del administrador de la demo. No la reutilices en producción.
ADMIN_PASSWORD=

# ===== CORS =====
# Orígenes permitidos, separados por coma (sin comodín cuando hay credenciales).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== Mock SOAP =====
# Puerto del mock WireMock en el anfitrión (el backend lo consume en la red interna).
SOAP_MOCK_PORT=8089

# ===== Frontend (Vite) =====
# URL absoluta de la API. Déjala vacía si usas el mismo origen (proxy/nginx).
VITE_API_URL=
FRONTEND_PORT=5173
