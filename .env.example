# ────────────────────────────────────────────────────────────────────────────
# DriveAI — Variables de entorno (plantilla)
#
# 1) Copia este archivo a `.env`:
#       cp .env.example .env          (macOS / Linux)
#       copy .env.example .env        (Windows PowerShell)
#
# 2) Completa GROQ_API_KEY con tu clave de https://console.groq.com/keys
#
# 3) CERO secrets versionados: `.env` está excluido del repositorio.
# ────────────────────────────────────────────────────────────────────────────

# ===== PostgreSQL =====
# Base de datos principal del e-commerce.
POSTGRES_DB=cardb
POSTGRES_USER=cardb_user
# Contraseña de desarrollo. Cámbiala antes de desplegar en producción.
POSTGRES_PASSWORD=cardb_pass
# Puerto expuesto de PostgreSQL (anfitrión). Por defecto 5432.
POSTGRES_PORT=5432

# ===== Groq Cloud (LLM / IA) =====
# Obtén tu API Key gratis en https://console.groq.com/keys
# Formato esperado: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
# Modelo usado por el asesor IA. No cambiar salvo requerimiento específico.
GROQ_MODEL=llama-3.3-70b-versatile
# URL base de la API de Groq (compatible con OpenAI).
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ===== Backend (Spring Boot) =====
# Perfiles: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Máximo de recomendaciones IA permitidas por minuto y por usuario/IP.
RATE_LIMIT_PER_MINUTE=5

# ===== Frontend (Vite) =====
# URL absoluta de la API. Déjala vacía si usas el mismo origen (proxy/nginx).
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=5173